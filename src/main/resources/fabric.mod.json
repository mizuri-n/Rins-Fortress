{
  "schemaVersion": 1,
  "id": "shieldmod",
  "version": "${version}",

  "name": "Rin's Fortress",
  "description": "This mod aims to add more options of defense to BTA!",
  "authors": [
    "Mizuri-n",
		"Useless",
		"Khrep",
		"Redart15"
  ],
  "contact": {
    "homepage": "https://github.com/mizuri-n/Better-with-defense",
    "sources": ""
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
        "mizurin.shieldmod.ShieldMod"
    ],

		"beforeGameStart": [
			"mizurin.shieldmod.ShieldMod",
			"mizurin.shieldmod.compat.aether.RFAetherCompatibility"
		],

		"beforeClientStart": [
			"mizurin.shieldmod.ShieldModClient"
		],

		"afterGameStart": [
			"mizurin.shieldmod.ShieldMod"
		],

		"recipesReady": [
			"mizurin.shieldmod.Recipes",
			"mizurin.shieldmod.compat.aether.RFAetherCompatibility"
		],

		"initModels": [
			"mizurin.shieldmod.RFModelEntryPoint",
			"mizurin.shieldmod.compat.aether.RFAetherCompatibility"
		],

		"preLaunch": ["mizurin.shieldmod.compat.aether.RFAetherCompatibility"]
	},
  "mixins": [
		"shieldmod.mixins.json"
  ],

	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"catalyst-core": ">=${catalystcore}",
		"catalyst-effects": ">=${catalysteffects}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}",
		"aether": ">=${aether}",
		"nonamedyes": ">=${nonamedyes}"
	}
}
